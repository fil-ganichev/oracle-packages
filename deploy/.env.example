# Oracle Database XE в Docker (gvenzl/oracle-xe)
# Скопируйте в .env и при необходимости измените значения.
# cp .env.example .env

# Имя контейнера
ORACLE_CONTAINER_NAME=oracle-packages-db

# Образ Docker Hub (открытый, без учётной записи Oracle)
# Варианты: 21-slim, 21, 21-faststart, 23-slim-free (gvenzl/oracle-free)
ORACLE_IMAGE=gvenzl/oracle-xe:21-slim

# Пароль SYS / SYSTEM (обязателен при первом запуске)
ORACLE_PASSWORD=OraclePackages1

# PDB и пользователь приложения (создаются при первой инициализации)
ORACLE_DATABASE=XEPDB1
APP_USER=oracle_packages
APP_USER_PASSWORD=OraclePackages1

# Порт на хосте
ORACLE_PORT=1521

# Том для данных (имя Docker volume)
ORACLE_VOLUME=oracle-packages-oradata
